# Copy to `.env` to override backend defaults (auto-loaded by backend/config.py).
# Uvicorn CLI flags (--host/--port) always win over these.

DOM_HOST=127.0.0.1
DOM_PORT=8000

# Broadcast cadence in milliseconds (lower = snappier flashes, more CPU).
DOM_TICK_MS=300

# Price levels per side of the book.
DOM_DEPTH=10

# CORS: "*" for any origin, or a comma-separated allowlist,
# e.g. https://your-frontend.hostingersite.com
DOM_CORS_ORIGINS=*
